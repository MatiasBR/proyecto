   20 statement: IDENTIFIER ASSIGN expr SEMICOLON
   21          | method_call SEMICOLON
   22          | IF LPAREN expr RPAREN THEN block ELSE block
   23          | WHILE expr block
   24          | RETURN expr SEMICOLON
   25          | RETURN SEMICOLON
   26          | block

   27 method_call: IDENTIFIER LPAREN arg_list RPAREN

   28 arg_list: /* empty */
   29         | expr
   30         | arg_list COMMA expr

   31 expr: IDENTIFIER
